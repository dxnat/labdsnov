{
  "name": "labdsnov",
  "version": "0.0.1",
  "description": "DSADV design system: Thai-first shadcn/ui components on Base UI, styled with Tailwind CSS v4 CSS modules.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pack:dry": "pnpm pack --dry-run",
    "tokens:check": "node scripts/tokens.mjs check",
    "tokens:docs": "node scripts/tokens.mjs docs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "react-day-picker": "^10.0.2",
    "recharts": "3.8.0",
    "sonner": "^2.0.8"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/nextjs-vite": "10.6.7",
    "@tailwindcss/vite": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "storybook": "10.6.7",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^7"
  }
}
